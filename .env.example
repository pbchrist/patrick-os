# Patrick OS reads every credential from the environment. config/routes.json
# stores only the NAME of the variable that holds one, never a value.
#
# Nothing here is required to run `patrick skills`, `patrick route`,
# `patrick test`, or any dry run. These matter only for `patrick run --execute`.

# Local OpenAI-compatible endpoint (the Qwen server Site Factory also writes to).
PATRICK_LOCAL_BASE_URL=http://127.0.0.1:8082/v1
PATRICK_LOCAL_API_KEY=local

# Hermes provides its own auth through its existing OAuth logins. No key here.
PATRICK_HERMES_COMMAND=hermes

# Anthropic, when the draft route is used.
ANTHROPIC_API_KEY=

# Deliberately NOT plain OPENAI_API_KEY: that variable is set to the literal
# string "local" for the Qwen server in Site Factory's .env, and reusing it would
# send a junk key to api.openai.com.
OPENAI_API_KEY_PATRICK_OS=
