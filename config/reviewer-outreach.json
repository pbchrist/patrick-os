{
  "version": 6,
  "project": "gate-of-nyandor-reviewer-outreach",
  "sender_account_label": "Nyandor",
  "canonical_tracker_sheet": "All Reviewers (351)",
  "auto_invoke_on_reviewer_send_intent": true,
  "send_intent_examples": [
    "send",
    "send more",
    "send N more",
    "do another batch",
    "reach out to reviewers",
    "email reviewers"
  ],
  "explicit_skill_name_not_required": true,
  "forbid_helper_tabs_for_contact_state": true,
  "require_live_policy_check": true,
  "require_current_activity_check": true,
  "require_personalization_evidence": true,
  "require_prior_contact_check": true,
  "require_prior_contact_check_sources": [
    "canonical_tracker",
    "nyandor_gmail_sent"
  ],
  "require_reply_reconciliation_before_batch": true,
  "require_reply_writeback_on_observed_reply": true,
  "reply_source": "nyandor_gmail",
  "reply_writeback_fields": [
    "Response",
    "Notes"
  ],
  "human_handles_reply_content_does_not_disable_tracking": true,
  "require_explicit_send_authorization": true,
  "require_tracking_writeback": true,
  "require_writeback_before_next_send": true,
  "require_post_send_verification": true,
  "abort_batch_on_duplicate_or_state_conflict": true,
  "forbid_replacement_sends_after_error": true,
  "enforce_authorized_batch_ceiling": true,
  "require_side_by_side_cover": true,
  "forbid_current_claim_without_current_evidence": true,
  "forbid_book_one_dismissal": true,
  "forbid_em_dash": true,
  "jev_gate_profile": "reviewer-outreach",
  "require_jev_candidate_gate": true,
  "require_jev_draft_gate": true,
  "jev_max_batch_items": 20,
  "jev_compact_state_only": true,
  "jev_may_not_override_deterministic_state": true,
  "jev_deterministic_authority_fields": [
    "canonical_tracker_status",
    "prior_contact",
    "nyandor_gmail_sent",
    "existing_draft",
    "explicit_send_authorization",
    "post_send_writeback"
  ],
  "jev_unavailable_action": "escalate_semantic_gate_not_auto_pass"
}
